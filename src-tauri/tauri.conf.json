{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ModelJourney",
  "version": "0.1.3",
  "identifier": "com.modeljourney.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "模途 / ModelJourney",
        "width": 1100,
        "height": 800,
        "minWidth": 300,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyM0VDMjQ3Q0U3QzNFQkYKUldTL1Buek9SOEkrY2hrRXprQkllYmZvUkxRWGpqZ3EyWWpRU0V4UkZrQ1JJamdrUFdwckJoN1IK",
      "endpoints": [
        "https://github.com/txquan06-max/modelvault/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/txquan06-max/modelvault/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/txquan06-max/modelvault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 24
    }
  }
}