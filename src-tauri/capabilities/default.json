{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-create",
    "fs:scope-home-recursive",
    "fs:scope-app-recursive",
    "dialog:default",
    "dialog:allow-open",
    "process:default",
    "updater:default"
  ]
}